# Static bar sprite for the "general killed" popups.
# GFX_popup_progressbar is a progressbartype whose fill is driven by the engine's message
# system; in a custom scripted_gui it renders empty. This uses the bar's fill texture as a
# plain sprite so it always shows a full, visible bar.
spriteTypes = {
	spriteType = {
		name = "GFX_mfu_killed_popup_bar"
		texturefile = "gfx/interface/deployment_entry_progressbar.dds"
	}
}
